[connection]
id=eduroam
uuid=4c2e4284-b5db-464d-b586-f340d93bc0b3
type=wifi
permissions=user:root:;

[wifi]
ssid=eduroam

[wifi-security]
group=ccmp;tkip;
key-mgmt=wpa-eap
pairwise=ccmp;
proto=rsn;

[802-1x]
altsubject-matches=DNS:radius0.nbi.ac.uk;DNS:radius1.nbi.ac.uk;DNS:radius2.nbi.ac.uk;
ca-cert=/root/.config/cat_installer/ca.pem
eap=peap;
identity=wot25kir@nbi.ac.uk
password=<REDACTED>
phase2-auth=mschapv2

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
